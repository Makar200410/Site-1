---
import { breadcrumbListJsonLd } from '@/lib/seo';

interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
const jsonLd = breadcrumbListJsonLd(items, Astro.site!.toString());
---

<nav aria-label="Хлебные крошки" class="mx-auto max-w-6xl px-4 pt-4 text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-[var(--text-muted)]">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="text-[var(--text)]">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-[var(--text)] hover:underline">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
