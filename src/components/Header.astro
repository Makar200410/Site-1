---
const nav = [
  { href: '/teoriya/', label: 'Теория' },
  { href: '/zadaniya/', label: 'Задания' },
  { href: '/trenazher/', label: 'Тренажёр' },
  { href: '/probniki/', label: 'Пробники' },
  { href: '/spravochnik/', label: 'Справочник' },
  { href: '/moy-progress/', label: 'Мой прогресс' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg-elevated)]/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="tap-target flex items-center gap-2 text-lg font-bold text-[var(--text)]">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white">O</span>
      <span>ОГЭ <span class="text-brand-600">Химия</span></span>
    </a>

    <nav aria-label="Основная навигация" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => {
          const active = path === item.href || path.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class={`tap-target flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors ${
                  active
                    ? 'bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-200'
                    : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]'
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="/poisk/"
        aria-label="Поиск по сайту"
        class="tap-target flex items-center justify-center rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
        </svg>
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Переключить тему"
        class="tap-target flex items-center justify-center rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]"
      >
        <svg id="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg id="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>

      <details class="relative lg:hidden">
        <summary
          class="tap-target flex list-none items-center justify-center rounded-md text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)] [&::-webkit-details-marker]:hidden"
          aria-label="Меню"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav aria-label="Мобильная навигация" class="absolute right-0 top-full mt-2 w-56 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] p-2 shadow-lg">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} class="tap-target flex items-center rounded-md px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--bg-muted)]">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    var sun = document.getElementById('icon-sun');
    var moon = document.getElementById('icon-moon');
    function isDark() {
      var saved = null;
      try {
        saved = localStorage.getItem('theme');
      } catch (e) {}
      if (saved === 'dark') return true;
      if (saved === 'light') return false;
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function sync() {
      var dark = isDark();
      sun.classList.toggle('hidden', dark);
      moon.classList.toggle('hidden', !dark);
    }
    sync();
    btn.addEventListener('click', function () {
      var next = isDark() ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      sync();
    });
  })();
</script>
