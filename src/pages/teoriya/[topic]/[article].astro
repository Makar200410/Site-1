---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ChemHtml from '@/components/ChemHtml.astro';
import { getCollection, render } from 'astro:content';
import { getCodifierTopic, getExamTaskMeta } from '@/config/exam';
import { articleJsonLd, breadcrumbListJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('theory');
  return entries.map((entry) => {
    const article = entry.id.split('/').slice(1).join('/');
    return { params: { topic: entry.data.topicId, article }, props: { entry } };
  });
}

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'theory'>>>[number] };
const { Content, headings } = await render(entry);
const topic = getCodifierTopic(entry.data.topicId)!;

const allTasks = await getCollection('tasks');
const checkTasks = allTasks.filter((t) => t.data.theoryRefs.includes(entry.id)).slice(0, 5);

const siteUrl = Astro.site!.toString();
const articleUrl = `/teoriya/${topic.id}/${entry.id.split('/').slice(1).join('/')}/`;
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Теория', url: '/teoriya/' },
  { name: topic.title, url: `/teoriya/${topic.id}/` },
  { name: entry.data.title, url: articleUrl },
];

const dateStr = entry.data.updatedAt.toISOString();
const jsonLd: Record<string, unknown>[] = [
  breadcrumbListJsonLd(breadcrumbs, siteUrl),
  articleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    url: articleUrl,
    siteUrl,
    datePublished: dateStr,
    dateModified: dateStr,
  }),
];

const toc = headings.filter((h) => h.depth <= 3);
---

<BaseLayout title={`${entry.data.title} — теория ОГЭ по химии`} description={entry.data.description} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbs} />
  <article class="mx-auto max-w-6xl px-4 py-8">
    <div class="lg:grid lg:grid-cols-[1fr_260px] lg:gap-10">
      <div class="min-w-0">
        <header>
          <p class="text-sm font-medium text-brand-600">
            <a href={`/teoriya/${topic.id}/`} class="hover:underline">{topic.title}</a>
          </p>
          <h1 class="mt-1 text-3xl font-extrabold text-[var(--text)]">{entry.data.title}</h1>
          <p class="mt-2 flex items-center gap-2 text-sm text-[var(--text-muted)]">
            <time datetime={dateStr}>Обновлено {entry.data.updatedAt.toLocaleDateString('ru-RU')}</time>
            <span aria-hidden="true">·</span>
            <span>{entry.data.readingTime} мин чтения</span>
          </p>
        </header>

        <div class="prose-chem mt-6 text-[var(--text)]">
          <Content />
        </div>

        {checkTasks.length > 0 && (
          <section class="mt-12 rounded-xl border border-[var(--border)] bg-[var(--bg-muted)] p-5" aria-labelledby="check-yourself-heading">
            <h2 id="check-yourself-heading" class="text-xl font-bold text-[var(--text)]">Проверь себя</h2>
            <p class="mt-1 text-sm text-[var(--text-muted)]">{checkTasks.length} заданий по теме «{entry.data.title}»</p>
            <ul class="mt-4 space-y-3">
              {checkTasks.map((task) => (
                <li class="rounded-lg bg-[var(--bg-elevated)] p-4">
                  <p class="text-sm font-medium text-[var(--text-muted)]">Задание {task.data.examNumber} ОГЭ</p>
                  <ChemHtml source={task.data.statement} class="mt-1 text-[15px]" />
                </li>
              ))}
            </ul>
            <a
              href={`/trenazher/?topic=${topic.id}`}
              class="tap-target mt-4 inline-flex items-center rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
            >
              Тренировать тему «{topic.title}»
            </a>
          </section>
        )}

        {entry.data.relatedTasks.length > 0 && (
          <nav class="mt-8" aria-label="Связанные задания ОГЭ">
            <h2 class="text-lg font-bold text-[var(--text)]">Эта тема встречается в заданиях</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {entry.data.relatedTasks.map((n) => {
                const meta = getExamTaskMeta(n);
                return (
                  <li>
                    <a
                      href={`/zadaniya/${n}/`}
                      class="tap-target inline-flex items-center rounded-full border border-[var(--border)] px-3 py-1.5 text-sm text-[var(--text)] hover:border-brand-400"
                    >
                      № {n}{meta ? `: ${meta.title}` : ''}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        )}
      </div>

      {toc.length > 0 && (
        <aside class="mt-10 hidden lg:mt-0 lg:block">
          <div class="sticky top-20">
            <p class="text-sm font-semibold text-[var(--text)]">На этой странице</p>
            <ul class="mt-3 space-y-2 border-l border-[var(--border)] pl-3 text-sm">
              {toc.map((h) => (
                <li style={h.depth === 3 ? 'padding-left:0.75rem' : undefined}>
                  <a href={`#${h.slug}`} class="text-[var(--text-muted)] hover:text-[var(--text)]">{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>

  <script is:inline define:vars={{ articleId: entry.id }}>
    (function () {
      var marked = false;
      function markRead() {
        if (marked) return;
        marked = true;
        try {
          var raw = localStorage.getItem('oge-himiya:progress');
          var state = raw ? JSON.parse(raw) : { version: 1, tasks: {}, theory: {}, mocks: {}, streak: {} };
          if (!state.theory) state.theory = {};
          state.theory[articleId] = { read: true, at: new Date().toISOString() };
          if (!state.version) state.version = 1;
          if (!state.tasks) state.tasks = {};
          if (!state.mocks) state.mocks = [];
          if (!state.streak) state.streak = { current: 0, longest: 0, lastActiveDate: null };
          localStorage.setItem('oge-himiya:progress', JSON.stringify(state));
        } catch (e) {}
      }
      var timer = setTimeout(markRead, 15000);
      var sentinel = document.querySelector('article');
      if (sentinel && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                markRead();
                io.disconnect();
                clearTimeout(timer);
              }
            });
          },
          { threshold: 0 },
        );
        var els = sentinel.querySelectorAll('h2, h3');
        var last = els[els.length - 1];
        if (last) io.observe(last);
      }
    })();
  </script>
</BaseLayout>
