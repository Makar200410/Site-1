---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbListJsonLd } from '@/lib/seo';
import { EXAM_CONFIG } from '@/config/exam';

const siteUrl = Astro.site!.toString();
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'О проекте', url: '/o-proekte/' },
];
const jsonLd = breadcrumbListJsonLd(breadcrumbs, siteUrl);
---

<BaseLayout
  title="О проекте «ОГЭ Химия»"
  description="«ОГЭ Химия» — бесплатный образовательный проект для подготовки девятиклассников к ОГЭ по химии, без регистрации и рекламы."
  jsonLd={jsonLd}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="prose-chem mx-auto max-w-2xl px-4 py-8 text-[var(--text)]">
    <h1 class="text-3xl font-extrabold">О проекте</h1>
    <p>
      «ОГЭ Химия» — бесплатный сайт для самостоятельной подготовки девятиклассников к ОГЭ по химии. Здесь есть
      теория по всем темам кодификатора ФИПИ, тренажёр по каждому из {EXAM_CONFIG.totalTasks} заданий экзамена, пробные варианты с
      таймером и справочные таблицы, разрешённые на экзамене.
    </p>

    <h2>Без регистрации</h2>
    <p>
      На сайте нет аккаунтов, форм регистрации и сбора персональных данных. Весь прогресс — решённые задания,
      прочитанные статьи, результаты пробников — хранится локально в вашем браузере. Вы можете в любой момент
      экспортировать его в файл и перенести на другое устройство на странице{' '}
      <a href="/moy-progress/">«Мой прогресс»</a>.
    </p>

    <h2>Метрика и cookies</h2>
    <p>
      Сайт использует Яндекс.Метрику для анонимной статистики посещаемости — какие страницы читают, откуда приходят
      посетители. Метрика использует cookies. Мы не передаём эти данные третьим лицам и не связываем их с личностью
      посетителя.
    </p>

    <h2>Дисклеймер</h2>
    <p>
      Материалы сайта носят информационный характер, написаны самостоятельно и не являются официальными
      материалами ФИПИ. Перед экзаменом обязательно сверяйтесь с актуальной демоверсией и кодификатором на
      официальном сайте ФИПИ.
    </p>

    <h2>Связь</h2>
    <p>
      Нашли ошибку в задании или теории? Есть предложение? Напишите на{' '}
      <a href="mailto:hello@oge-himia.ru">hello@oge-himia.ru</a>.
    </p>
  </article>
</BaseLayout>
